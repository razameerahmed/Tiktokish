{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "targets": {
      "file": {
        "type": "File",
        "fileName": "D:\\Logs\\UserServiceLogs\\UserService_${shortdate}.log",
        "layout": "${longdate}|${logger}|CorrelationId=${event-properties:item=CorrelationId} |${level}|${threadid}|${event-properties:item=ENTITY}|${event-properties:item=UPDATED_BY}|${event-properties:item=MACHINE_NAME}|${event-properties:item=EVENT_ORIGIN}|${event-properties:item=ACTION}|${event-properties:item=RESULT}|${event-properties:item=MESSAGE}|${event-properties:item=DESCRIPTION}|${event-properties:item=EXCEPTION}"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "file"
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=AS-EFT-KHALID\\KHALID;Initial Catalog=Tracker;Persist Security Info=True;User ID=avanza;Password=Karachi@123456;"
  },
  "Email": {
    "fromEmail": "syedkhalidhalim@gmail.com",
    "password": "",
    "smptServer": "smtp.gmail.com",
    "port": "587",
    "ssl": true,
    "rules": [
      {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "file"
      }
    ]
  }
}

